---
import Portfolio from '../../components/Portfolio.astro';
import Layout from '../../layouts/Layout.astro';
import { locales } from '../../i18n/config';
import { getMessages } from '../../i18n/messages';

const t = getMessages('en').portfolio;
---

<Layout locale="en" availableLocales={[...locales]} title={t.meta.title} description={t.meta.description} themeColor="black">
	<Portfolio locale="en" />
</Layout>
