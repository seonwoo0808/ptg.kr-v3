---
import type { PortfolioRecord } from '../../i18n/types';

interface Props {
	items: PortfolioRecord[];
	empty: string;
	surface?: boolean;
}

const { items, empty, surface = false } = Astro.props;
const itemBackground = surface ? 'bg-zinc-900' : 'bg-zinc-950';
---

{items.length ? (
	<div class="grid gap-px bg-white/10">
		{items.map((item) => (
			<article class:list={['grid gap-4 p-6 sm:grid-cols-[1fr_auto]', itemBackground]}>
				<div>
					<h3 class="text-xl font-semibold">{item.title}</h3>
					<p class="mt-2 font-sans text-sm text-zinc-400">{item.issuer}</p>
					{item.description && <p class="mt-4 font-sans text-sm leading-[1.7] text-zinc-400">{item.description}</p>}
				</div>
				<span class="text-xs text-zinc-500 ko:text-sm">{item.period}</span>
			</article>
		))}
	</div>
) : (
	<p class="border border-dashed border-white/10 px-6 py-12 font-sans text-sm text-zinc-500">{empty}</p>
)}
