---
import type { PortfolioMessages } from '../../i18n/types';
import PortfolioSection from './PortfolioSection.astro';

interface Props { experience: PortfolioMessages['experience']; }
const { experience } = Astro.props;
---

<PortfolioSection id="experience" index="02" eyebrow={experience.eyebrow} title={experience.title} surface>
	<div class="grid gap-[50px] lg:grid-cols-[.75fr_1.25fr] lg:gap-[clamp(50px,10vw,150px)]">
		<div>
			<span class="text-xs tracking-[.12em] text-zinc-500 ko:text-sm">{experience.period}</span>
			<h3 class="type-h4 mb-2 mt-6">{experience.company}</h3>
			<p class="m-0 text-xs text-teal-400 ko:text-[13px]">{experience.role}</p>
		</div>
		<div>
			<p class="type-p1 mb-[38px] text-zinc-100 [word-break:keep-all]">{experience.description}</p>
			<ul class="m-0 list-none border-t border-white/10 p-0">
				{experience.highlights.map((item) => <li class="type-p3 border-b border-white/10 py-[17px] pl-6 text-zinc-400 before:-ml-6 before:pr-[14px] before:text-teal-400 before:content-['↳']">{item}</li>)}
			</ul>
		</div>
	</div>
</PortfolioSection>
