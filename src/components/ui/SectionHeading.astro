---
interface Props {
	eyebrow?: string;
	title: string;
	description?: string;
	id?: string;
	class?: string;
}

const { eyebrow, title, description, id, class: className } = Astro.props;
---

<header class:list={['space-y-3', className]}>
	{eyebrow && <span class="ds-eyebrow">{eyebrow}</span>}
	<h2 id={id} class="type-h2 text-foreground">
		{title}
	</h2>
	{description && <p class="type-p3 max-w-2xl text-muted-foreground">{description}</p>}
</header>
